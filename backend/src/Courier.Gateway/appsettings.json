{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" } },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "shipments": { "ClusterId": "shipments", "Match": { "Path": "/api/shipments/{**catch-all}" } },
      "quotes":    { "ClusterId": "pricing",   "Match": { "Path": "/api/quotes/{**catch-all}" } },
      "tracking":  { "ClusterId": "tracking",  "Match": { "Path": "/api/tracking/{**catch-all}" } }
    },
    "Clusters": {
      "shipments": { "Destinations": { "d1": { "Address": "http://localhost:5102/" } } },
      "pricing":   { "Destinations": { "d1": { "Address": "http://localhost:5101/" } } },
      "tracking":  { "Destinations": { "d1": { "Address": "http://localhost:5103/" } } }
    }
  }
}
